# Copy to .env and fill in. .env is gitignored; never commit real values.

# --- Mode -------------------------------------------------------------------
# standalone (default) or socialpulse
APP_MODE=standalone

# --- App ----------------------------------------------------------------------
# dev | test | prod
ENVIRONMENT=dev
# Where the seller app, API (/api/v1) and public shop pages (/s/<shop>) are served.
# Production: https://shop.shankhyaai.com
PUBLIC_BASE_URL=http://localhost:5173
DATABASE_URL=sqlite:///./storage/shelf.db

# --- Meta Model API (https://dev.meta.ai) -----------------------------------
# Keys start with LLM_. Create one per app in the Model API dashboard.
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
# Never set a *-contributor model here: those let Meta train on uploaded content.
META_VISION_MODEL=muse-spark-1.3
META_SEGMENT_MODEL=sam-3.1
META_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0
META_IMAGE_MODEL=muse-image-1.0

# --- Baseten (optional text-only steps) -------------------------------------
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL_ID=meta-models/muse-spark-open
# meta (default) or baseten
TEXT_LLM_PROVIDER=meta

# --- Spend caps (USD) -------------------------------------------------------
SPEND_CAP_PER_JOB_USD=0.50
SPEND_CAP_PER_WORKSPACE_DAY_USD=3.00
SPEND_CAP_PER_INSTANCE_DAY_USD=25.00
